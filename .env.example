# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/oforugo_db

# Flask session secret — any long random string
SESSION_SECRET=change-me-to-a-long-random-secret

# Paystack public key (get from https://dashboard.paystack.com → Settings → API Keys)
# Use pk_test_... for testing, pk_live_... for production
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
